[gd_scene load_steps=2 format=3 uid="uid://cf7wmiatk0xba"]

[sub_resource type="GDScript" id="GDScript_ep8nf"]
script/source = "extends Control

@onready var bar: ProgressBar = $ProgressBar

func update_health(current: int, max: int) -> void:
	var value: float = (float(current) / float(max)) * 100.0
	bar.value = value
"

